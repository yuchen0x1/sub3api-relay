[Unit]
Description=Sub3API Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=sub3api
Group=sub3api
WorkingDirectory=/opt/sub3api
ExecStart=/opt/sub3api/datamanagementd \
  -socket-path /tmp/sub3api-datamanagement.sock \
  -sqlite-path /var/lib/sub3api/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
# PrivateTmp 必须保持 false：与主服务通过 /tmp 下的共享套接字通信。
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sub3api /tmp
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
