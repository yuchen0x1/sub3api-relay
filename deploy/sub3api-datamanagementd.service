[Unit]
Description=Sub3API Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=sub3api
Group=sub3api
WorkingDirectory=/opt/sub3api
ExecStart=/opt/sub3api/datamanagementd \
  -socket-path /tmp/sub3api-datamanagement.sock \
  -sqlite-path /var/lib/sub3api/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
