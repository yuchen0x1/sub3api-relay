{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sub3API Cockpit",
  "version": "0.4.3",
  "identifier": "com.sub3api.cockpit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Sub3API Cockpit", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 640, "resizable": true }]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFQzIxOTcxMDY1MkE0RDgKUldUWXBGSUdjUm5DcmpDems0bTdXMndQdWs2a0xidW1HMzJtRno2ei9MWTVQVzRCMExkeHYwbGwK",
      "endpoints": [
        "https://github.com/yuchen0x1/sub3api-relay/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
